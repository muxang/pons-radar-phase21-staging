[Unit]
Description=Pons Radar read-only monitoring service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pons-radar
Group=pons-radar
WorkingDirectory=/var/lib/pons-radar
UMask=0027
EnvironmentFile=/etc/pons-radar/environment
Environment=PONS_CONFIG=/etc/pons-radar/config.toml
ExecStart=/opt/pons-radar/pons-radar
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pons-radar /opt/pons-radar
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
